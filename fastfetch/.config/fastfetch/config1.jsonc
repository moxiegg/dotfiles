{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/pngs/brook.png\" )",
    "height": 18,
    "padding": {
        "right": 0
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": " -------------------------------- 󱓇  ------------------------------ ",
      "outputcolor":"#c8c093"
    },
    {
      "type": "custom",
      "format": "  No matter how deep the night, it always turns to day, eventually " ,
      "outputcolor": "#c7682e"
    },
    {
      "type": "custom",
      "format": " -------------------------------- 󱓇  ------------------------------ ",
      "outputcolor":"#c8c093"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "   ",
    },
    {
      "type": "kernel",
      "key": "   "
    },
    {
      "type": "packages",
      "key": "  󰏗 "
    },
    {
      "type": "display",
      "key": "  󱍜 ",
    },
    {
      "type": "wm",
      "key": "   ",
    },
    {
      "type": "terminal",
      "key": "   ",
    },
    {
      "type": "media",
      "key": "  󰝚 ",
    },

     {
            "type": "command",
            "key": "  󱦟 ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days young"
        },

     {
            "type": "uptime",
            "key": "   ",
        },
    {
      "type": "custom",
      "key":"  󰊤 ",
      "format": "moxiegg",
      "outputcolor": "#c8c093"
    },
    "break",
    {
      "type": "title",
      "key": "   ",
    },
    {
      "type": "custom",
      "format": "",
      "key":" ",
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "   ",
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": "   ",
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "   ",
    },
    {
      "type": "memory",
      "key": "   ",
    },
    {
      "type": "custom",
      "format": "",
      "key":" "
    },
  ]
}
